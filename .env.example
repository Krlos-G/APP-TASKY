# ------------------------------------------------------------------
# Copie este arquivo para .env e ajuste os valores.
# O .env NAO e versionado (esta no .gitignore).
# ------------------------------------------------------------------

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=tasky
POSTGRES_USER=tasky
POSTGRES_PASSWORD=troque-esta-senha
# 5433 e nao 5432 de proposito: muitas maquinas ja tem um PostgreSQL nativo
# ocupando a 5432, e o conflito e silencioso - a aplicacao conecta no servidor
# errado e falha com "senha invalida".
POSTGRES_PORT=5433

# --- Backend (Spring Boot) ---
# Os defaults do application.yml ja apontam para o compose local;
# estas variaveis existem para sobrescrever quando necessario.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/tasky
SPRING_DATASOURCE_USERNAME=tasky
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# --- Autenticacao ---
# Chave HMAC do access token. MINIMO 32 bytes; a aplicacao recusa subir se for menor.
# Gere uma com: openssl rand -base64 48
TASKY_JWT_SECRET=troque-por-um-segredo-longo-de-no-minimo-32-bytes

# Codigo exigido no registro. VAZIO OU AUSENTE DESABILITA O REGISTRO.
TASKY_CODIGO_CONVITE=

# Politica do cookie de refresh.
#   Lax  = front e API na mesma origem (padrao)
#   None = origens separadas; exige TASKY_COOKIE_SECURE=true
TASKY_COOKIE_SAMESITE=Lax
# false permite testar em http://localhost; true e obrigatorio em producao.
TASKY_COOKIE_SECURE=false

# Origem permitida no CORS. Vazio = sem CORS (mesma origem).
TASKY_CORS_ORIGEM=

# Tentativas de login permitidas por IP a cada minuto.
TASKY_MAX_TENTATIVAS_LOGIN=10

# Porta do backend no host.
BACKEND_PORT=8080

# --- Notificacoes (Web Push / VAPID) ---
# Gere um par com:
#   docker compose run --rm backend mvn -q exec:java -Dexec.mainClass=...
# ou pelo utilitario da propria lib. As duas chaves sao base64url sem padding.
# VAZIO OU AUSENTE DESABILITA AS NOTIFICACOES (a aplicacao sobe normalmente).
TASKY_VAPID_PUBLICA=
TASKY_VAPID_PRIVADA=
# Contato do responsavel, exigido pelo protocolo (mailto: ou https:).
TASKY_VAPID_ASSUNTO=mailto:voce@exemplo.com
