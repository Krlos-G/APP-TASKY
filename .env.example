# ------------------------------------------------------------------
# Copie este arquivo para .env e ajuste os valores.
# O .env NAO e versionado (esta no .gitignore).
# ------------------------------------------------------------------

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=tasky
POSTGRES_USER=tasky
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# Os defaults do application.yml ja apontam para o compose local;
# estas variaveis existem para sobrescrever quando necessario.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tasky
SPRING_DATASOURCE_USERNAME=tasky
SPRING_DATASOURCE_PASSWORD=troque-esta-senha
